# Copy to .env.local for local use. On Firebase App Hosting these come from apphosting.yaml secrets.

# MongoDB connection (MongoDB Atlas: Connect > Drivers). Local default: mongodb://127.0.0.1:27017/quarry_billing
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quarry_billing?retryWrites=true&w=majority

# Long random text that signs login sessions. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account (production). Open /api/seed once after the first deploy; it only works while there are no users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
